@using RecettesFamille.Dto.Models

<MudStack Spacing="3" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudText Typo="Typo.h6">Mes voyages</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Add" 
                          Color="Color.Primary" 
                          Size="Size.Small"
                          OnClick="OnCreateTravel"
                          Title="Créer un voyage" />
        </MudStack>

        <MudDivider />

        <MudList T="string" Dense="true" Class="pa-0">
            <MudListItem T="string" 
                        OnClick="@(() => OnFilterChange(null, "all"))"
                        Class="@GetListItemClass(null, "all")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" />
                        <MudText>Tous les résumés</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@TotalCount</MudChip>
                </MudStack>
            </MudListItem>

            <MudListItem T="string" 
                        OnClick="@(() => OnFilterChange(null, "unclassified"))"
                        Class="@GetListItemClass(null, "unclassified")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Default" />
                        <MudText>Non classés</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@UnclassifiedCount</MudChip>
                </MudStack>
            </MudListItem>

            @foreach (var travel in Travels.Where(t => !t.IsArchived).OrderByDescending(t => t.CreatedDate))
            {
                var count = SummariesCount.GetValueOrDefault(travel.Id, 0);
                <MudListItem T="string" 
                            OnClick="@(() => OnFilterChange(travel.Id, "travel"))"
                            Class="@GetListItemClass(travel.Id, "travel")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Luggage" Size="Size.Small" Color="Color.Primary" />
                            @* Wrapper nécessaire pour ellipsis (min-width: 0 requis pour text-overflow dans flexbox) *@
                            <div class="d-flex flex-grow-1" style="min-width: 0;">
                                <MudText Class="text-truncate">@travel.Name</MudText>
                            </div>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@count</MudChip>
                            @* Wrapper nécessaire pour empêcher la propagation du clic vers MudListItem parent *@
                            <div @onclick:stopPropagation="true" class="d-inline-flex">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                              Size="Size.Small" 
                                              OnClick="@(() => OnEditTravel(travel))"
                                              Title="Modifier" />
                            </div>
                        </MudStack>
                    </MudStack>
                </MudListItem>
            }

            @if (Travels.Any(t => t.IsArchived))
            {
                <MudDivider Class="my-2" />
                <MudListItem T="string" 
                            OnClick="@(() => OnFilterChange(null, "archived"))"
                            Class="@GetListItemClass(null, "archived")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" />
                            <MudText>Archivés</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Travels.Count(t => t.IsArchived)</MudChip>
                    </MudStack>
                </MudListItem>
            }
        </MudList>

        @* Filtres Section *@
        <MudDivider Class="my-3" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Filtres</MudText>
            @if (HasActiveFilters)
            {
                <MudButton Size="Size.Small" 
                          Variant="Variant.Text" 
                          Color="Color.Secondary"
                          OnClick="ResetSecondaryFilters"
                          StartIcon="@Icons.Material.Filled.FilterAltOff">
                    Réinitialiser
                </MudButton>
            }
        </MudStack>

        <MudList T="string" Dense="true" Class="pa-0">
            @* Favorites Filter *@
            <MudListItem T="string" 
                        OnClick="ToggleFavoritesFilter"
                        Class="@(FilterFavoritesOnly ? "mud-selected-item mud-ripple" : "")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="@(FilterFavoritesOnly ? Color.Warning : Color.Default)" />
                        <MudText>Favoris uniquement</MudText>
                    </MudStack>
                    @if (FavoritesCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@FavoritesCount</MudChip>
                    }
                </MudStack>
            </MudListItem>

            @* Status Filters *@
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Class="px-4 py-2">Statut</MudText>

            <MudListItem T="string" 
                        OnClick="@(() => ToggleStatusFilter(SummaryStatus.ToReview))"
                        Class="@(SelectedStatuses.Contains(SummaryStatus.ToReview) ? "mud-selected-item mud-ripple" : "")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Default" />
                        <MudText>À consulter</MudText>
                    </MudStack>
                    @if (StatusCounts.GetValueOrDefault(SummaryStatus.ToReview, 0) > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@StatusCounts[SummaryStatus.ToReview]</MudChip>
                    }
                </MudStack>
            </MudListItem>

            <MudListItem T="string" 
                        OnClick="@(() => ToggleStatusFilter(SummaryStatus.Reviewed))"
                        Class="@(SelectedStatuses.Contains(SummaryStatus.Reviewed) ? "mud-selected-item mud-ripple" : "")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Info" />
                        <MudText>Consulté</MudText>
                    </MudStack>
                    @if (StatusCounts.GetValueOrDefault(SummaryStatus.Reviewed, 0) > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@StatusCounts[SummaryStatus.Reviewed]</MudChip>
                    }
                </MudStack>
            </MudListItem>

            <MudListItem T="string" 
                        OnClick="@(() => ToggleStatusFilter(SummaryStatus.Selected))"
                        Class="@(SelectedStatuses.Contains(SummaryStatus.Selected) ? "mud-selected-item mud-ripple" : "")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Success" />
                        <MudText>Retenu</MudText>
                    </MudStack>
                    @if (StatusCounts.GetValueOrDefault(SummaryStatus.Selected, 0) > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@StatusCounts[SummaryStatus.Selected]</MudChip>
                    }
                </MudStack>
            </MudListItem>

            <MudListItem T="string" 
                        OnClick="@(() => ToggleStatusFilter(SummaryStatus.Rejected))"
                        Class="@(SelectedStatuses.Contains(SummaryStatus.Rejected) ? "mud-selected-item mud-ripple" : "")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Error" />
                        <MudText>Écarté</MudText>
                    </MudStack>
                    @if (StatusCounts.GetValueOrDefault(SummaryStatus.Rejected, 0) > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@StatusCounts[SummaryStatus.Rejected]</MudChip>
                    }
                </MudStack>
            </MudListItem>

            @* Categories Filters *@
            @if (Categories.Any())
            {
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-4 py-2">
                    <MudText Typo="Typo.subtitle2">Catégories</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                  Color="Color.Primary" 
                                  Size="Size.Small"
                                  OnClick="OnCreateCategory"
                                  Title="Créer une catégorie" />
                </MudStack>

                @foreach (var category in Categories.OrderBy(c => c.Name))
                {
                    var count = CategoryCounts.GetValueOrDefault(category.Id, 0);
                    var isSelected = SelectedCategoryIds.Contains(category.Id);
                    var iconStyle = !string.IsNullOrWhiteSpace(category.Color) ? $"color: {category.Color}; font-size: 12px;" : "font-size: 12px;";
                    <MudListItem T="string" 
                                OnClick="@(() => ToggleCategoryFilter(category.Id))"
                                Class="@(isSelected ? "mud-selected-item mud-ripple" : "")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @if (!string.IsNullOrWhiteSpace(category.Color))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="@iconStyle" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Color="Color.Primary" />
                                }
                                <MudText Class="text-truncate">@category.Name</MudText>
                            </MudStack>
                            @if (count > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@count</MudChip>
                            }
                        </MudStack>
                    </MudListItem>
                }
            }
            else
            {
                <MudDivider Class="my-2" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-4 py-2">
                    <MudText Typo="Typo.subtitle2">Catégories</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                  Color="Color.Primary" 
                                  Size="Size.Small"
                                  OnClick="OnCreateCategory"
                                  Title="Créer une catégorie" />
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 py-2">
                    Aucune catégorie. Cliquez sur + pour en créer.
                </MudText>
            }
        </MudList>
</MudStack>

@code {
    [Parameter] public List<TravelDto> Travels { get; set; } = [];
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public Dictionary<int, int> SummariesCount { get; set; } = new();
    [Parameter] public Dictionary<int, int> CategoryCounts { get; set; } = new();
    [Parameter] public Dictionary<SummaryStatus, int> StatusCounts { get; set; } = new();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int UnclassifiedCount { get; set; }
    [Parameter] public int FavoritesCount { get; set; }
    [Parameter] public int? SelectedTravelId { get; set; }
    [Parameter] public string SelectedFilterType { get; set; } = "all";
    [Parameter] public bool FilterFavoritesOnly { get; set; }
    [Parameter] public HashSet<int> SelectedCategoryIds { get; set; } = new();
    [Parameter] public HashSet<SummaryStatus> SelectedStatuses { get; set; } = new();
    [Parameter] public EventCallback<(int? travelId, string filterType)> OnFilterChanged { get; set; }
    [Parameter] public EventCallback<bool> OnFavoritesFilterChanged { get; set; }
    [Parameter] public EventCallback<HashSet<int>> OnCategoryFiltersChanged { get; set; }
    [Parameter] public EventCallback<HashSet<SummaryStatus>> OnStatusFiltersChanged { get; set; }
    [Parameter] public EventCallback OnCreateTravelClicked { get; set; }
    [Parameter] public EventCallback<TravelDto> OnEditTravelClicked { get; set; }
    [Parameter] public EventCallback OnCreateCategoryClicked { get; set; }

    private bool HasActiveFilters => FilterFavoritesOnly || SelectedCategoryIds.Any() || SelectedStatuses.Any();

    private string GetListItemClass(int? travelId, string filterType)
    {
        var isSelected = (SelectedFilterType == filterType && 
                         (filterType != "travel" || SelectedTravelId == travelId));
        return isSelected ? "mud-selected-item mud-ripple" : "";
    }

    private async Task OnFilterChange(int? travelId, string filterType)
    {
        await OnFilterChanged.InvokeAsync((travelId, filterType));
    }

    private async Task OnCreateTravel()
    {
        await OnCreateTravelClicked.InvokeAsync();
    }

    private async Task OnEditTravel(TravelDto travel)
    {
        await OnEditTravelClicked.InvokeAsync(travel);
    }

    private async Task OnCreateCategory()
    {
        await OnCreateCategoryClicked.InvokeAsync();
    }

    private async Task ToggleFavoritesFilter()
    {
        await OnFavoritesFilterChanged.InvokeAsync(!FilterFavoritesOnly);
    }

    private async Task ToggleCategoryFilter(int categoryId)
    {
        var newSet = new HashSet<int>(SelectedCategoryIds);
        if (newSet.Contains(categoryId))
            newSet.Remove(categoryId);
        else
            newSet.Add(categoryId);

        await OnCategoryFiltersChanged.InvokeAsync(newSet);
    }

    private async Task ToggleStatusFilter(SummaryStatus status)
    {
        var newSet = new HashSet<SummaryStatus>(SelectedStatuses);
        if (newSet.Contains(status))
            newSet.Remove(status);
        else
            newSet.Add(status);

        await OnStatusFiltersChanged.InvokeAsync(newSet);
    }

    private async Task ResetSecondaryFilters()
    {
        await OnFavoritesFilterChanged.InvokeAsync(false);
        await OnCategoryFiltersChanged.InvokeAsync(new HashSet<int>());
        await OnStatusFiltersChanged.InvokeAsync(new HashSet<SummaryStatus>());
    }
}
