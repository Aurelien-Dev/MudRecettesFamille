<MudPaper Elevation="2" Class="pa-4" Style="background-color: white; height: 100%;">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="SearchText" 
                      Label="Rechercher un résumé" 
                      Variant="Variant.Outlined"
                      Placeholder="Titre ou contenu..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      OnClearButtonClick="@(() => OnSearchChanged.InvokeAsync(string.Empty))"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="@(() => OnSearchChanged.InvokeAsync(SearchText))" />

        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
            @FilteredSummaries.Count résumé(s)
        </MudText>

        <MudDivider />

        @if (!FilteredSummaries.Any())
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="my-8">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2" />
                <br />
                Aucun résumé ne correspond aux critères.
            </MudText>
        }
        else
        {
            <div style="max-height: 60vh; overflow-y: auto;">
                <MudStack Spacing="4">
                    @foreach (var summary in FilteredSummaries.OrderByDescending(x => x.CreatedDate))
                    {
                        <MudPaper Elevation="@(SelectedSummaryId == summary.Id ? 3 : 1)" 
                                 Class="@(SelectedSummaryId == summary.Id ? "mud-theme-primary pa-5" : "pa-5")"
                                 Style="cursor: pointer; transition: all 0.2s;"
                                 @onclick="@(() => OnSummarySelected.InvokeAsync(summary))">
                            <MudStack Row="true" Spacing="3">
                                @* Left section: Thumbnail *@
                                <div style="width: 200px; min-width: 200px; position: relative;">
                                    @if (thumbnailErrors.ContainsKey(summary.Id) && thumbnailErrors[summary.Id])
                                    {
                                        @* Placeholder when thumbnail fails to load *@
                                        <div style="width: 100%; aspect-ratio: 16/9; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <MudIcon Icon="@Icons.Custom.Brands.YouTube" Color="Color.Error" Size="Size.Large" />
                                        </div>
                                    }
                                    else
                                    {
                                        @* YouTube thumbnail *@
                                        <MudImage Src="@GetThumbnailUrl(summary.Url)" 
                                                 Alt="@summary.Title"
                                                 ObjectFit="ObjectFit.Cover"
                                                 Style="width: 100%; aspect-ratio: 16/9; border-radius: 8px;"
                                                 ErrorContent="@(new RenderFragment(builder =>
                                                 {
                                                     HandleImageError(summary.Id);
                                                     StateHasChanged();
                                                 }))" />
                                    }
                                </div>

                                @* Right section: Content *@
                                <MudStack Spacing="3" Justify="Justify.SpaceBetween" Style="flex: 1; min-width: 0;">
                                    @* Top: Title *@
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Style="font-size: 1.05rem; font-weight: 600; line-height: 1.3;">
                                            @summary.Title
                                        </MudText>
                                    </div>

                                    @* Middle: Category chips *@
                                    @if (summary.CategoryNames.Any())
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex-wrap: wrap;">
                                            @for (int i = 0; i < Math.Min(3, summary.CategoryNames.Count); i++)
                                            {
                                                var categoryName = summary.CategoryNames[i];
                                                var categoryColor = summary.CategoryColors.ElementAtOrDefault(i);
                                                <MudChip T="string" 
                                                        Size="Size.Small" 
                                                        Color="@(string.IsNullOrWhiteSpace(categoryColor) ? Color.Primary : Color.Default)"
                                                        Variant="Variant.Text"
                                                        Style="@(string.IsNullOrWhiteSpace(categoryColor) ? "" : $"background-color: {categoryColor}30; color: {categoryColor}")">
                                                    @categoryName
                                                </MudChip>
                                            }
                                            @if (summary.CategoryNames.Count > 3)
                                            {
                                                <MudChip T="string" 
                                                        Size="Size.Small" 
                                                        Color="Color.Default" 
                                                        Variant="Variant.Text">
                                                    +@(summary.CategoryNames.Count - 3)
                                                </MudChip>
                                            }
                                        </MudStack>
                                    }

                                    @* Bottom: Metadata line *@
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap: wrap;">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Ajouté à :
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(summary.TravelName))
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.Luggage" Size="Size.Small" Style="font-size: 0.9rem;" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @summary.TravelName
                                                </MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Style="font-size: 0.9rem;" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Non classé
                                                </MudText>
                                            </MudStack>
                                        }
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            •
                                        </MudText>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Style="font-size: 0.9rem;" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                À venir
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </div>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public List<YoutubeResumeDto> FilteredSummaries { get; set; } = [];
    [Parameter] public int? SelectedSummaryId { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<YoutubeResumeDto> OnSummarySelected { get; set; }
    [Parameter] public EventCallback<YoutubeResumeDto> OnDeleteSummaryClicked { get; set; }

    private Dictionary<int, bool> thumbnailErrors = new();

    private void HandleImageError(int summaryId)
    {
        thumbnailErrors[summaryId] = true;
    }

    private Color GetStatusColor(SummaryStatus status)
    {
        return status switch
        {
            SummaryStatus.ToReview => Color.Default,
            SummaryStatus.Reviewed => Color.Info,
            SummaryStatus.Selected => Color.Success,
            SummaryStatus.Rejected => Color.Error,
            _ => Color.Default
        };
    }

    private string GetStatusLabel(SummaryStatus status)
    {
        return status switch
        {
            SummaryStatus.ToReview => "À consulter",
            SummaryStatus.Reviewed => "Consulté",
            SummaryStatus.Selected => "Retenu",
            SummaryStatus.Rejected => "Écarté",
            _ => "Inconnu"
        };
    }

    private string? ExtractVideoId(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        try
        {
            var uri = new Uri(url);

            // Format: https://www.youtube.com/watch?v=VIDEO_ID ou https://youtube.com/watch?v=VIDEO_ID
            if ((uri.Host.Contains("youtube.com") || uri.Host.Contains("www.youtube.com")) && uri.AbsolutePath == "/watch")
            {
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var videoId = query["v"];

                if (!string.IsNullOrWhiteSpace(videoId))
                {
                    return videoId;
                }
            }

            // Format: https://youtu.be/VIDEO_ID
            if (uri.Host == "youtu.be" && uri.AbsolutePath.Length > 1)
            {
                return uri.AbsolutePath.TrimStart('/');
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    private string GetThumbnailUrl(string url)
    {
        var videoId = ExtractVideoId(url);
        if (string.IsNullOrWhiteSpace(videoId))
        {
            return string.Empty;
        }

        return $"https://img.youtube.com/vi/{videoId}/mqdefault.jpg";
    }
}
