@using RecettesFamille.Services
@using Microsoft.Extensions.AI
@inject RecipeRagService RagService

<MudPaper Class="pa-3" Elevation="2">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.h6">👨‍🍳 Chef Virtuel</MudText>
        @if (displayMessages.Count > 0)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="ClearChat">
                Nouvelle conversation
            </MudButton>
        }
    </div>

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Discutez avec votre chef personnel ! Posez toutes vos questions sur cette recette 🍽️
    </MudText>

    <ChatMessageList Messages="@displayMessages" IsLoading="@isLoading" />

    @* Question suggestions as chips *@
    @if (questionSuggestions.Any() && displayMessages.Count == 0)
    {
        <div class="mb-3">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                💡 Suggestions de questions :
            </MudText>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var suggestion in questionSuggestions)
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.QuestionAnswer"
                             OnClick="@(() => HandleSuggestionClick(suggestion))">
                        @suggestion
                    </MudChip>
                }
            </div>
        </div>
    }
    else if (isLoadingSuggestions && displayMessages.Count == 0)
    {
        <div class="mb-3 d-flex align-center gap-2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Génération de suggestions...
            </MudText>
        </div>
    }

    <ChatInput @ref="chatInputRef"
               OnSendMessage="@HandleSendMessage"
               IsDisabled="@(isLoading || RecipeId <= 0)"
               Placeholder="Posez votre question sur cette recette..."
               Label="Votre question"
               SendButtonText="Envoyer" />

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="@(() => errorMessage = string.Empty)">
            @errorMessage
        </MudAlert>
    }

    @if (RecipeId <= 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2">
            Aucune recette sélectionnée. Veuillez spécifier un ID de recette.
        </MudAlert>
    }
</MudPaper>

@code {
    [Parameter]
    public int RecipeId { get; set; }

    private bool isLoading = false;
    private string errorMessage = string.Empty;

    // Store full conversation history (including system prompt)
    private List<ChatMessage> messages = new();

    // Display messages (excluding system prompt)
    private List<ChatMessage> displayMessages => messages.Where(m => m.Role != ChatRole.System).ToList();

    // Question suggestions management
    private ChatInput? chatInputRef;
    private List<string> questionSuggestions = new();
    private bool isLoadingSuggestions = false;
    private int previousRecipeId = 0;

    protected override async Task OnParametersSetAsync()
    {
        // Only regenerate suggestions if RecipeId has changed
        if (RecipeId > 0 && RecipeId != previousRecipeId)
        {
            previousRecipeId = RecipeId;
            await LoadQuestionSuggestionsAsync();
        }
        else if (RecipeId <= 0)
        {
            // Reset when no recipe
            questionSuggestions.Clear();
            previousRecipeId = 0;
        }
    }

    private async Task LoadQuestionSuggestionsAsync()
    {
        isLoadingSuggestions = true;
        StateHasChanged();

        try
        {
            // Generate 5 suggestions
            questionSuggestions = await RagService.GetSuggestedQuestionsAsync(RecipeId, 5);
        }
        catch
        {
            // Fail silently
            questionSuggestions.Clear();
        }
        finally
        {
            isLoadingSuggestions = false;
            StateHasChanged();
        }
    }

    private async Task HandleSuggestionClick(string question)
    {
        if (chatInputRef != null)
        {
            await chatInputRef.SetSuggestionAsync(question);
        }
    }

    private async Task HandleSendMessage(string question)
    {
        if (string.IsNullOrWhiteSpace(question) || RecipeId <= 0)
            return;

        errorMessage = string.Empty;

        // Add user message to display
        var userMessage = new ChatMessage(ChatRole.User, question);
        messages.Add(userMessage);

        isLoading = true;
        StateHasChanged();

        try
        {
            // Get chat history (excluding the current user message for API call)
            var historyForApi = messages.Take(messages.Count - 1).Where(m => m.Role != ChatRole.System).ToList();

            var response = await RagService.ChatWithRecipeAsync(RecipeId, question, historyForApi);

            // Add assistant response
            var assistantMessage = new ChatMessage(ChatRole.Assistant, response);
            messages.Add(assistantMessage);
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur : {ex.Message}";
            // Remove the user message if API call failed
            messages.RemoveAt(messages.Count - 1);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearChat()
    {
        messages.Clear();
        errorMessage = string.Empty;
    }
}
